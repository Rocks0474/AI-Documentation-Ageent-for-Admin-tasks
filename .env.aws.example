# AWS deployment configuration — copy to .env.aws and fill in.
# CLOUD_TARGET=AWS activates the AWS adapters; GCP/LOCAL blocks are ignored.
# The same Docker image deploys here as to GCP — only these values change.

# Required for all targets
CLOUD_TARGET=AWS
ANTHROPIC_API_KEY=            # or fetched via SecretsAdapter at runtime
LOG_LEVEL=INFO

# Agent configuration
DEFAULT_JURISDICTION=JP
DEFAULT_OUTPUT_LANGUAGE=EN
MINIMUM_COHORT_SIZE=10

# PII Gateway
HRIS_SYSTEM=SMARTHR
HRIS_API_BASE_URL=
HRIS_API_KEY_SECRET=hris-api-key

# Integrations (all optional)
GREENHOUSE_CONNECTED=false
GOODTIME_CONNECTED=false
DEEL_CONNECTED=false
PANALYT_CONNECTED=false
ARIZE_CONNECTED=false

# AWS-specific
AWS_REGION=ap-northeast-1      # Tokyo — default for JP clients
AWS_ACCOUNT_ID=
S3_BUCKET_ZONE2=
S3_BUCKET_ZONE3=
S3_BUCKET_AUDIT=
SQS_QUEUE_URL_ROUTING=
OPENSEARCH_ENDPOINT_ZONE2=
OPENSEARCH_ENDPOINT_ZONE3=
