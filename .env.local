# Local development configuration — CLOUD_TARGET=LOCAL.
# Safe to commit: contains no real secrets. Put local secrets in
# secrets.local.json (git-ignored), read by the LOCAL SecretsAdapter.

# Required for all targets
CLOUD_TARGET=LOCAL
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO

# Agent configuration
DEFAULT_JURISDICTION=JP
DEFAULT_OUTPUT_LANGUAGE=EN
MINIMUM_COHORT_SIZE=10

# PII Gateway
HRIS_SYSTEM=SMARTHR
HRIS_API_BASE_URL=
HRIS_API_KEY_SECRET=hris-api-key

# Integrations (all optional — agents degrade gracefully if absent)
GREENHOUSE_CONNECTED=false
GOODTIME_CONNECTED=false
DEEL_CONNECTED=false
PANALYT_CONNECTED=false
ARIZE_CONNECTED=false

# Local dev
LOCAL_STORAGE_ROOT=./local_storage
LOCAL_SECRETS_FILE=./secrets.local.json
