# GCP deployment configuration — copy to .env.gcp and fill in.
# CLOUD_TARGET=GCP activates the GCP adapters; AWS/LOCAL blocks are ignored.

# Required for all targets
CLOUD_TARGET=GCP
ANTHROPIC_API_KEY=            # or fetched via SecretsAdapter at runtime
LOG_LEVEL=INFO

# Agent configuration
DEFAULT_JURISDICTION=JP
DEFAULT_OUTPUT_LANGUAGE=EN
MINIMUM_COHORT_SIZE=10

# PII Gateway
HRIS_SYSTEM=SMARTHR
HRIS_API_BASE_URL=
HRIS_API_KEY_SECRET=hris-api-key

# Integrations (all optional)
GREENHOUSE_CONNECTED=false
GOODTIME_CONNECTED=false
DEEL_CONNECTED=false
PANALYT_CONNECTED=false
ARIZE_CONNECTED=false

# GCP-specific
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1     # Tokyo — default for JP clients
GCS_BUCKET_ZONE2=
GCS_BUCKET_ZONE3=
GCS_BUCKET_AUDIT=
PUBSUB_TOPIC_ROUTING=
VERTEX_INDEX_ID_ZONE2=
VERTEX_INDEX_ID_ZONE3=
